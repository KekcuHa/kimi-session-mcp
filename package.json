    "mcp-server",
    "agent-to-agent",
    "session-messaging"
  ],
  "author": "Alexander Yavorsky (KekcuHa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KekcuHa/kimi-session-mcp.git"
  },
  "homepage": "https://github.com/KekcuHa/kimi-session-mcp#readme",
  "bugs": "https://github.com/KekcuHa/kimi-session-mcp/issues",
